# MemGate 模型连接预设 — 云 API 连接模式 (OpenAI 兼容协议)
# 用法: source 本文件后启动, 或写入部署环境
# 云 API = LLM_ARM 指向任意 OpenAI 兼容云端 (DeepSeek/硅基流动/自建均可)

export LLM_ARM_HOST="https://api.deepseek.com/v1"
# 回落链可选: 本地模型兜底 (首项优先; 只用云则留 HOST 即可)
# export LLM_ARM_HOSTS="https://api.deepseek.com/v1,http://localhost:8082"
export LLM_ARM_MODEL="deepseek-chat"
export LLM_ARM_CHAT="1"
export LLM_ARM_TIMEOUT="30"
# 鉴权: 云端 key 走环境变量, 永不写入本文件
# export OPENAI_API_KEY="sk-..."
